{
  "schemaVersion": 1,
  "id": "mctraveler-test",
  "version": "${version}",
  "name": "MCTraveler test harness",
  "description": "Headless gametests and the production smoke hook for the mctraveler mod.",
  "environment": "server",
  "entrypoints": {
    "fabric-gametest": [
      "eu.mctraveler.gametest.ScaffoldGameTest",
      "eu.mctraveler.gametest.PersistenceGameTest",
      "eu.mctraveler.gametest.XpOrbMergeGameTest",
      "eu.mctraveler.gametest.MotdGameTest",
      "eu.mctraveler.gametest.TabListGameTest",
      "eu.mctraveler.gametest.IdentityRemapGameTest",
      "eu.mctraveler.gametest.PrivateMessagesGameTest",
      "eu.mctraveler.gametest.ChatGameTest",
      "eu.mctraveler.gametest.AwayGameTest",
      "eu.mctraveler.gametest.NotepadGameTest",
      "eu.mctraveler.gametest.WorldsGameTest",
      "eu.mctraveler.gametest.RespawnAndPortalsGameTest",
      "eu.mctraveler.gametest.RegionCommandGameTest",
      "eu.mctraveler.gametest.RegionAdminCommandGameTest",
      "eu.mctraveler.gametest.RegionMembershipGameTest",
      "eu.mctraveler.gametest.RegionScoreboardGameTest",
      "eu.mctraveler.gametest.MigrationGameTest"
    ],
    "server": [
      {
        "adapter": "kotlin",
        "value": "eu.mctraveler.gametest.SmokeHook"
      },
      {
        "adapter": "kotlin",
        "value": "eu.mctraveler.gametest.GameTestJanitor"
      }
    ]
  },
  "mixins": ["mctraveler-test.mixins.json"],
  "depends": {
    "mctraveler": "*"
  }
}
