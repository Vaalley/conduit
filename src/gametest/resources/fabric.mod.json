      "eu.mctraveler.gametest.WorldMergeGameTest",
      "eu.mctraveler.gametest.OrphanedSaveClaimGameTest",
      "eu.mctraveler.gametest.RegionProtectionGameTest",
      "eu.mctraveler.gametest.RegionEnvironmentGameTest",
      "eu.mctraveler.gametest.RegionFlagGameTest",
      "eu.mctraveler.gametest.EmbassiesGameTest",
      "eu.mctraveler.gametest.CrystalCraftingGameTest",
      "eu.mctraveler.gametest.CrystalEnergyGameTest",
      "eu.mctraveler.gametest.CrystalCommandGameTest",
      "eu.mctraveler.gametest.EmbassyPlotGameTest",
      "eu.mctraveler.gametest.EmbassyCommandGameTest",
      "eu.mctraveler.gametest.EmbassyAnchorGameTest",
      "eu.mctraveler.gametest.CrystalMenuGameTest",
      "eu.mctraveler.gametest.VanishGameTest",
      "eu.mctraveler.gametest.ModerationGameTest",
      "eu.mctraveler.gametest.ActionLogGameTest",
      "eu.mctraveler.gametest.InvseeGameTest",
      "eu.mctraveler.gametest.SleepRequirementGameTest",
