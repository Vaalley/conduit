      "eu.mctraveler.gametest.SignNameTokenGameTest",
      "eu.mctraveler.gametest.RtpGameTest"
    ],
    "server": [
      {
        "adapter": "kotlin",
        "value": "eu.mctraveler.gametest.GameTestJanitor"
      },
      {
        "adapter": "kotlin",
        "value": "eu.mctraveler.smoke.SmokeHook"
      }
    ]
  },
  "mixins": ["mctraveler-test.mixins.json"],
  "depends": {
    "mctraveler": "*"
  }
}
